# WeedICider production environment

# Frontend (Vercel)
# Set this to the public Render URL after the backend deploys.
VITE_API_BASE_URL=https://weedicider-api.onrender.com

# Backend (Render)
FLASK_DEBUG=0
DATA_DIR=/tmp/weedicider
MAX_UPLOAD_MB=16

# Comma-separated frontend origins allowed to call the API. Use "*" for easiest deployment,
# or replace with your exact Vercel URL for stricter production CORS.
ALLOWED_ORIGINS=*

# Optional: URL to a hosted .pt model file. If unset and no model file is present,
# the API stays online in deterministic demo mode instead of crashing.
MODEL_URL=

# Optional: absolute path to a model file inside the backend container.
MODEL_PATH=
